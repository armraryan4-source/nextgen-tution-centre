/* =========================================================
   HELPERS
========================================================= */

function showError(error){

  alert(
    error &&
    error.message
      ? error.message
      : 'Something went wrong.'
  );

}


function safe(value){

  if(
    value === null ||
    value === undefined
  ){
    return '';
  }

  return String(value)
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}


function safeAttr(value){

  return safe(value);
}


function safeJs(value){

  return String(value)
    .replace(/\\/g,'\\\\')
    .replace(/'/g,"\\'")
    .replace(/"/g,'\\"');
}


