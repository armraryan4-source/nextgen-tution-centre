<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, maximum-scale=1.0">

  <title>GOJO AI</title>


<style>

*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,
body{

  margin:0;
  width:100%;
  height:100%;

  overflow:hidden;

  background:#000;
  color:white;

  font-family:
    Arial,
    Helvetica,
    sans-serif;
}


/* ================================================= */
/* VIDEO */
/* ================================================= */

.bgVideo{

  position:fixed;

  top:50%;
  left:50%;

  width:100vh;
  height:100vw;

  object-fit:cover;

  transform:
    translate(-50%,-50%)
    rotate(-90deg);

  z-index:0;

  pointer-events:none;

  opacity:0;

  transition:
    opacity .4s ease;

  filter:
    brightness(1.1)
    contrast(1.12)
    saturate(1.08);

}

#bgVideo1{
  opacity:1;
}


/* ================================================= */
/* OVERLAY */
/* ================================================= */

.darkOverlay{

  position:fixed;

  inset:0;

  z-index:1;

  background:
    rgba(0,0,0,.15);

  pointer-events:none;

}


/* ================================================= */
/* STARS */
/* ================================================= */

#stars{

  position:fixed;

  inset:0;

  z-index:2;

  overflow:hidden;

  pointer-events:none;

}

.star{

  position:absolute;

  width:3px;
  height:3px;

  border-radius:50%;

  background:#35c9ff;

  box-shadow:
    0 0 6px #35c9ff,
    0 0 14px #168cff;

  animation:
    starFloat linear infinite,
    starBlink ease-in-out infinite;

}

@keyframes starFloat{

  from{
    transform:translateY(105vh);
  }

  to{
    transform:translateY(-10vh);
  }

}

@keyframes starBlink{

  0%,100%{
    opacity:.25;
  }

  50%{
    opacity:1;
  }

}


/* ================================================= */
/* GOJO PROFILE */
/* ================================================= */

#gojoProfile{

  position:fixed;

  top:12px;
  right:12px;

  width:135px;

  z-index:20;

  text-align:center;

  transition:
    transform .3s ease,
    filter .3s ease;

}

#gojoImageBox{

  position:relative;

  width:110px;
  height:155px;

  margin:auto;

}

#gojoImage{

  width:110px;
  height:155px;

  object-fit:cover;

  display:block;

  border-radius:5px;

  border:
    1px solid
    rgba(130,100,255,.45);

  box-shadow:
    0 0 15px
    rgba(50,100,255,.55);

}

#reactionEmoji{

  position:absolute;

  right:-13px;
  top:-13px;

  width:52px;
  height:52px;

  display:flex;

  align-items:center;
  justify-content:center;

  border-radius:50%;

  background:
    rgba(0,0,0,.78);

  border:
    2px solid
    rgba(255,255,255,.65);

  box-shadow:
    0 0 12px
    rgba(255,255,255,.45),
    0 0 25px
    rgba(80,120,255,.65);

  font-size:29px;

  z-index:50;

  opacity:0;

  transform:scale(.3);

  transition:
    opacity .2s ease,
    transform .25s ease;

}

#reactionEmoji.show{

  opacity:1;

  transform:scale(1);

  animation:
    emojiPop .55s ease-out;

}

@keyframes emojiPop{

  0%{
    transform:
      scale(.2)
      rotate(-20deg);
  }

  60%{
    transform:
      scale(1.25)
      rotate(8deg);
  }

  100%{
    transform:
      scale(1)
      rotate(0);
  }

}

#gojoName{

  margin-top:7px;

  font-size:21px;

  font-weight:900;

  letter-spacing:1px;

  text-shadow:
    0 0 8px #7460ff,
    0 0 20px #4130ff;

}

#status{

  margin-top:3px;

  font-size:10px;

  color:#8dff68;

}


/* ================================================= */
/* CHAT MEMORY PANEL */
/* ================================================= */

#chatPanel{

  position:fixed;

  right:17px;
  bottom:15px;

  width:min(
    430px,
    calc(100vw - 30px)
  );

  z-index:30;

  padding:14px;

  border-radius:20px;

  background:
    rgba(5,5,12,.86);

  border:
    1px solid
    rgba(160,130,255,.35);

  box-shadow:
    0 0 25px
    rgba(70,30,255,.28),
    inset 0 0 25px
    rgba(120,60,255,.04);

  backdrop-filter:blur(14px);

  transition:
    transform .35s ease;

}

#chatPanel.hidden{

  transform:
    translateY(
      calc(100% - 52px)
    );

}


/* ================================================= */
/* CHAT HEADER */
/* ================================================= */

#chatHeader{

  display:flex;

  align-items:center;

  justify-content:space-between;

  margin-bottom:10px;

}

#chatTitle{

  display:flex;

  align-items:center;

  gap:7px;

  font-size:14px;

  font-weight:bold;

  letter-spacing:1px;

}

.memoryBadge{

  padding:
    4px 7px;

  border-radius:8px;

  font-size:9px;

  color:#cbbcff;

  background:
    rgba(110,70,255,.15);

  border:
    1px solid
    rgba(140,110,255,.2);

}

.headerButtons{

  display:flex;

  gap:6px;

}

.headerBtn{

  width:32px;
  height:30px;

  border:none;

  border-radius:8px;

  color:white;

  background:
    rgba(100,70,255,.35);

  cursor:pointer;

  font-size:15px;

}

.headerBtn:active{

  transform:scale(.92);

}


/* ================================================= */
/* QUESTION */
/* ================================================= */

#question{

  width:100%;

  min-height:70px;

  max-height:130px;

  resize:none;

  outline:none;

  color:white;

  background:
    rgba(0,0,0,.60);

  border:
    1px solid
    rgba(180,150,255,.25);

  border-radius:15px;

  padding:15px;

  font-size:16px;

  font-family:
    Arial,
    Helvetica,
    sans-serif;

}

#question:focus{

  border-color:
    rgba(150,110,255,.7);

  box-shadow:
    0 0 15px
    rgba(110,70,255,.2);

}

#question::placeholder{

  color:
    rgba(255,255,255,.45);

}


/* ================================================= */
/* BUTTONS */
/* ================================================= */

.buttonRow{

  display:flex;

  gap:9px;

  margin-top:10px;

}

.actionBtn{

  height:46px;

  min-width:52px;

  border:none;

  border-radius:12px;

  color:white;

  cursor:pointer;

  font-size:19px;

  background:
    linear-gradient(
      135deg,
      #6640ff,
      #7b2cff
    );

  box-shadow:
    0 0 12px
    rgba(110,70,255,.35);

  transition:
    transform .15s ease,
    box-shadow .2s ease;

}

.actionBtn:active{

  transform:scale(.93);

}

.actionBtn:disabled{

  opacity:.55;

}

#sendBtn{

  flex:1;

  font-size:16px;

  font-weight:bold;

}

#micBtn{

  background:
    linear-gradient(
      135deg,
      #ff1744,
      #ff005d
    );

}

#micBtn.listening{

  animation:
    micPulse .8s infinite;

}

@keyframes micPulse{

  0%{
    box-shadow:
      0 0 5px #ff1744;
  }

  50%{
    box-shadow:
      0 0 30px #ff1744;
  }

  100%{
    box-shadow:
      0 0 5px #ff1744;
  }

}


/* ================================================= */
/* ANSWER */
/* ================================================= */

#answer{

  margin-top:10px;

  min-height:70px;

  max-height:180px;

  overflow-y:auto;

  padding:13px;

  border-radius:14px;

  background:
    rgba(0,0,0,.45);

  border:
    1px solid
    rgba(140,120,255,.15);

  color:#eeeeff;

  font-size:14px;

  line-height:1.55;

  white-space:pre-wrap;

}


/* ================================================= */
/* MEMORY STATUS */
/* ================================================= */

#memoryStatus{

  margin-top:7px;

  text-align:center;

  font-size:9px;

  color:
    rgba(190,175,255,.55);

}


/* ================================================= */
/* MODE BUTTONS */
/* ================================================= */

.modeBtn{

  position:fixed;

  left:20px;

  z-index:100000;

  padding:
    11px 15px;

  border:none;

  border-radius:10px;

  color:white;

  font-size:13px;

  font-weight:bold;

  cursor:pointer;

  transition:.2s;

}

.modeBtn:active{

  transform:scale(.94);

}

#testDomainBtn{

  top:20px;

  background:
    linear-gradient(
      135deg,
      #6d35ff,
      #a43cff
    );

  box-shadow:
    0 0 15px
    rgba(120,60,255,.6);

}

#hollowPurpleBtn{

  top:67px;

  background:
    linear-gradient(
      135deg,
      #4720ff,
      #b000ff,
      #632cff
    );

  box-shadow:
    0 0 12px #682cff,
    0 0 25px
    rgba(150,40,255,.55);

}

#powerBtn{

  top:114px;

  background:
    linear-gradient(
      135deg,
      #7b00ff,
      #ff00d4
    );

  box-shadow:
    0 0 18px #a000ff;

}

#infinityBtn{

  top:161px;

  background:
    linear-gradient(
      135deg,
      #006eff,
      #00d9ff
    );

  box-shadow:
    0 0 18px #00aaff;

}

#redBlueBtn{

  top:208px;

  background:
    linear-gradient(
      90deg,
      #ff003c,
      #6b00ff,
      #008cff
    );

  box-shadow:
    0 0 18px #ff1744;

}

.modeBtn.active{

  animation:
    modePulse .65s
    infinite alternate;

}

@keyframes modePulse{

  from{
    transform:scale(1);
  }

  to{
    transform:scale(1.06);
  }

}


/* ================================================= */
/* MODE SCREENS */
/* ================================================= */

#warningScreen,
#calmScreen,
#hollowPurpleScreen,
#powerScreen,
#infinityScreen,
#redBlueScreen{

  position:fixed;

  inset:0;

  display:none;

  align-items:center;
  justify-content:center;

  overflow:hidden;

  pointer-events:none;

}


/* ================================================= */
/* WARNING */
/* ================================================= */

#warningScreen{

  z-index:99999;

  background:
    rgba(25,0,0,.94);

}

#warningScreen.show{

  display:flex;

  animation:
    warningFlash .45s
    infinite alternate;

}

.warningStripe{

  position:absolute;

  width:200%;

  height:55px;

  background:
    repeating-linear-gradient(
      -45deg,
      #ffcc00 0 28px,
      #111 28px 56px
    );

  opacity:.9;

  animation:
    stripeMove 1s linear infinite;

}

.warningStripe.top{
  top:0;
}

.warningStripe.bottom{

  bottom:0;

  animation-direction:
    reverse;

}

@keyframes stripeMove{

  from{
    transform:translateX(0);
  }

  to{
    transform:translateX(-56px);
  }

}

.warningContent{

  position:relative;

  z-index:5;

  width:100%;

  text-align:center;

  animation:
    warningZoom 5s ease forwards;

}

.warningIcon{

  font-size:
    clamp(
      60px,
      16vw,
      130px
    );

  filter:
    drop-shadow(
      0 0 20px
      #ffcc00
    );

}

.warningText{

  margin-top:20px;

  font-size:
    clamp(
      34px,
      10vw,
      90px
    );

  font-weight:1000;

  letter-spacing:
    clamp(
      3px,
      1.5vw,
      12px
    );

  text-shadow:
    0 0 8px #ff0000,
    0 0 25px #ff0000,
    0 0 60px #ff7b00;

}

.warningSubText{

  margin-top:12px;

  font-size:
    clamp(
      13px,
      3vw,
      22px
    );

  font-weight:bold;

  letter-spacing:5px;

  color:#ffcc00;

}

@keyframes warningFlash{

  from{
    background:
      rgba(25,0,0,.94);
  }

  to{
    background:
      rgba(100,0,0,.92);
  }

}

@keyframes warningZoom{

  0%{
    transform:scale(.5);
    opacity:0;
  }

  12%{
    transform:scale(1);
    opacity:1;
  }

  78%{
    transform:scale(1.04);
    opacity:1;
  }

  100%{
    transform:scale(1.2);
    opacity:0;
  }

}


/* ================================================= */
/* CALM */
/* ================================================= */

#calmScreen{

  z-index:99999;

  background:
    radial-gradient(
      circle,
      rgba(90,170,255,.30),
      rgba(0,10,35,.96)
    );

}

#calmScreen.show{

  display:flex;

  animation:
    calmFade 3.5s ease forwards;

}

.calmGlow{

  position:absolute;

  width:100px;
  height:100px;

  border-radius:50%;

  background:
    rgba(160,220,255,.9);

  box-shadow:
    0 0 30px #a5ddff,
    0 0 80px #65bfff,
    0 0 160px #3b82f6;

  animation:
    calmGlow 3.5s
    ease forwards;

}

.calmCircle{

  position:absolute;

  width:100px;
  height:100px;

  border-radius:50%;

  border:
    2px solid
    rgba(180,230,255,.8);

  animation:
    calmCircle 3.5s
    ease-out forwards;

}

.calmCircle.two{
  animation-delay:.25s;
}

.calmCircle.three{
  animation-delay:.5s;
}

.calmContent{

  position:relative;

  z-index:5;

  text-align:center;

  animation:
    calmContent 3.5s
    ease forwards;

}

.calmIcon{

  font-size:
    clamp(
      65px,
      16vw,
      130px
    );

}

.calmText{

  margin-top:15px;

  font-size:
    clamp(
      32px,
      8vw,
      72px
    );

  font-weight:900;

  letter-spacing:5px;

  color:#e8f8ff;

  text-shadow:
    0 0 15px #73cfff,
    0 0 40px #3b82f6;

}

.calmSubText{

  margin-top:10px;

  font-size:
    clamp(
      12px,
      3vw,
      20px
    );

  letter-spacing:4px;

  color:#a8ddff;

}

@keyframes calmFade{

  0%{opacity:0;}
  15%{opacity:1;}
  75%{opacity:1;}
  100%{opacity:0;}

}

@keyframes calmGlow{

  0%{
    transform:scale(.1);
    opacity:0;
  }

  20%{
    transform:scale(1);
    opacity:.9;
  }

  100%{
    transform:scale(14);
    opacity:0;
  }

}

@keyframes calmCircle{

  0%{
    transform:scale(.2);
    opacity:0;
  }

  20%{
    opacity:1;
  }

  100%{
    transform:scale(15);
    opacity:0;
  }

}

@keyframes calmContent{

  0%{
    transform:scale(.7);
    opacity:0;
  }

  20%{
    transform:scale(1);
    opacity:1;
  }

  75%{
    transform:scale(1.03);
    opacity:1;
  }

  100%{
    transform:scale(1.12);
    opacity:0;
  }

}


/* ================================================= */
/* HOLLOW PURPLE */
/* ================================================= */

#hollowPurpleScreen{

  z-index:99998;

  background:
    radial-gradient(
      circle at center,
      rgba(150,0,255,.78),
      rgba(40,0,100,.88) 35%,
      rgba(5,0,20,.97) 75%
    );

}

#hollowPurpleScreen.show{

  display:flex;

  animation:
    hollowPurpleFade
    2.8s ease forwards;

}

.purpleCore{

  position:absolute;

  width:80px;
  height:80px;

  border-radius:50%;

  background:
    radial-gradient(
      circle,
      white 0%,
      #dcb6ff 12%,
      #a000ff 38%,
      #5420ff 68%,
      transparent 75%
    );

  box-shadow:
    0 0 25px white,
    0 0 60px #c000ff,
    0 0 130px #722cff,
    0 0 220px #3510ff;

  animation:
    purpleCore 2.8s
    ease forwards;

}

.purpleRing{

  position:absolute;

  width:100px;
  height:100px;

  border-radius:50%;

  border:
    3px solid
    rgba(190,80,255,.9);

  box-shadow:
    0 0 20px #9d32ff,
    inset 0 0 20px #4c00ff;

  animation:
    purpleRing 2.8s
    ease-out forwards;

}

.purpleRing.two{

  border-color:
    rgba(80,150,255,.8);

  animation-delay:.15s;

}

.purpleRing.three{

  border-color:
    rgba(255,80,255,.7);

  animation-delay:.3s;

}

.purpleEnergy{

  position:absolute;

  width:20px;
  height:160px;

  border-radius:50%;

  background:
    linear-gradient(
      transparent,
      #9d4dff,
      white,
      #b000ff,
      transparent
    );

  filter:blur(5px);

  opacity:.85;

  animation:
    energySpin 1s
    linear infinite;

}

.purpleEnergy.e2{
  transform:rotate(60deg);
}

.purpleEnergy.e3{
  transform:rotate(120deg);
}

.purpleEnergy.e4{
  transform:rotate(180deg);
}

.purpleContent{

  position:relative;

  z-index:10;

  text-align:center;

  animation:
    purpleContent 2.8s
    ease forwards;

}

.purpleIcon{

  font-size:
    clamp(
      65px,
      17vw,
      140px
    );

}

.purpleText{

  margin-top:12px;

  font-size:
    clamp(
      30px,
      8vw,
      78px
    );

  font-weight:1000;

  letter-spacing:
    clamp(
      3px,
      1vw,
      10px
    );

  color:#fff;

  text-shadow:
    0 0 10px white,
    0 0 25px #d000ff,
    0 0 55px #762cff,
    0 0 100px #3910ff;

}

.purpleSubText{

  margin-top:12px;

  font-size:
    clamp(
      12px,
      3vw,
      20px
    );

  letter-spacing:5px;

  font-weight:bold;

  color:#dfc8ff;

}

@keyframes hollowPurpleFade{

  0%{opacity:0;}
  12%{opacity:1;}
  72%{opacity:1;}
  100%{opacity:0;}

}

@keyframes purpleCore{

  0%{
    transform:scale(.1);
    opacity:0;
  }

  18%{
    transform:scale(1);
    opacity:1;
  }

  70%{
    transform:scale(2.2);
    opacity:.95;
  }

  100%{
    transform:scale(18);
    opacity:0;
  }

}

@keyframes purpleRing{

  0%{
    transform:scale(.1);
    opacity:0;
  }

  15%{
    opacity:1;
  }

  100%{
    transform:scale(18);
    opacity:0;
  }

}

@keyframes energySpin{

  from{
    transform:
      rotate(0deg)
      translateY(-15px);
  }

  to{
    transform:
      rotate(360deg)
      translateY(-15px);
  }

}

@keyframes purpleContent{

  0%{
    transform:scale(.3);
    opacity:0;
  }

  15%{
    transform:scale(1);
    opacity:1;
  }

  70%{
    transform:scale(1.05);
    opacity:1;
  }

  100%{
    transform:scale(1.2);
    opacity:0;
  }

}


/* ================================================= */
/* POWER */
/* ================================================= */

#powerScreen{

  z-index:99997;

  background:
    radial-gradient(
      circle,
      rgba(180,0,255,.8),
      rgba(70,0,140,.75) 35%,
      rgba(5,0,20,.97) 75%
    );

}

#powerScreen.show{

  display:flex;

  animation:
    powerFade 3s ease forwards;

}

.powerAura{

  position:absolute;

  width:150px;
  height:150px;

  border-radius:50%;

  border:
    8px solid
    #a000ff;

  box-shadow:
    0 0 25px #ff00e6,
    0 0 80px #7b00ff,
    inset 0 0 35px #c000ff;

  animation:
    powerAura 3s
    ease-out forwards;

}

.powerAura.two{

  width:300px;
  height:300px;

  border-color:#ff00aa;

  animation-delay:.15s;

}

.powerAura.three{

  width:500px;
  height:500px;

  border-color:#7200ff;

  animation-delay:.3s;

}

.powerBolt{

  position:absolute;

  width:8px;
  height:300px;

  background:
    linear-gradient(
      transparent,
      white,
      #d000ff,
      transparent
    );

  box-shadow:
    0 0 20px #c000ff;

  animation:
    powerSpin .8s
    linear infinite;

}

.powerBolt.b2{
  transform:rotate(45deg);
}

.powerBolt.b3{
  transform:rotate(90deg);
}

.powerBolt.b4{
  transform:rotate(135deg);
}

.powerContent{

  position:relative;

  z-index:10;

  text-align:center;

}

.powerIcon{

  font-size:
    clamp(
      70px,
      18vw,
      150px
    );

}

.powerText{

  font-size:
    clamp(
      38px,
      9vw,
      85px
    );

  font-weight:1000;

  letter-spacing:7px;

}

.powerSub{

  margin-top:10px;

  font-size:
    clamp(
      12px,
      3vw,
      22px
    );

  letter-spacing:5px;

  color:#efc8ff;

}

@keyframes powerFade{

  0%{opacity:0;}
  10%{opacity:1;}
  75%{opacity:1;}
  100%{opacity:0;}

}

@keyframes powerAura{

  0%{
    transform:
      scale(.1)
      rotate(0deg);

    opacity:0;
  }

  20%{
    opacity:1;
  }

  100%{
    transform:
      scale(7)
      rotate(360deg);

