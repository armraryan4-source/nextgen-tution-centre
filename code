/* ================================================= */
/* SEND QUESTION + MEMORY */
/* ================================================= */

function sendQuestion(){

  const question =
    questionInput.value.trim();


  if(!question){

    return;

  }


  setReaction(
    detectReaction(question)
  );


  status.innerText =
    "🟡 GOJO THINKING...";


  answerBox.innerText =
    "GOJO is thinking...";


  sendBtn.disabled=true;


  // Add user message to memory
  chatMemory.push({

    role:"user",

    text:question

  });


  saveMemory();


  // Copy current memory for backend
  const history =
    chatMemory.slice(-12);


  if(
    typeof google==="undefined" ||
    !google.script ||
    !google.script.run
  ){

    answerBox.innerText =
      "GOJO: Apps Script connection not available.";

    sendBtn.disabled=false;

    return;

  }


  google.script.run

    .withSuccessHandler(
      function(response){

        sendBtn.disabled=false;


        status.innerText =
          "🟢 GOJO ONLINE";


        answerBox.innerText =
          response;


        // Save GOJO answer
        chatMemory.push({

          role:"assistant",

          text:String(response)

        });


        saveMemory();


        speak(response);


        questionInput.value="";


        setTimeout(
          function(){

            setReaction(
              "thinking"
            );

          },
          3500
        );

      }
    )


    .withFailureHandler(
      function(error){

        sendBtn.disabled=false;


        status.innerText =
          "🟢 GOJO LOCAL MODE";


        const errorText =
          "GOJO: " +
          (
            error.message ||
            "AI connection unavailable."
          );


        answerBox.innerText =
          errorText;


        // Remove unanswered user
        // message if request failed
        chatMemory.pop();

        saveMemory();

      }
    )


    .askGOJO(
      question,
      history
    );

}


