/* ================================================= */
/* REACTION DETECTION */
/* ================================================= */

function detectReaction(text){

  const q =
    text
      .toLowerCase()
      .trim();


  if(
    q==="hello" ||
    q==="hi" ||
    q==="hey" ||
    q==="konnichiwa" ||
    q.includes("hello gojo") ||
    q.includes("hi gojo")
  ){

    return "greeting";

  }


  if(
    q.includes("joke") ||
    q.includes("funny") ||
    q.includes("make me laugh") ||
    q.includes("hasao") ||
    q.includes("हंसाओ")
  ){

    return "funny";

  }


  if(
    q.includes("wow") ||
    q.includes("amazing") ||
    q.includes("really") ||
    q.includes("seriously") ||
    q.includes("surprise")
  ){

    return "surprised";

  }


  if(
    q.includes("thank you") ||
    q.includes("thanks") ||
    q.includes("great answer")
  ){

    return "happy";

  }


  if(
    q.includes("danger") ||
    q.includes("warning") ||
    q.includes("emergency") ||
    q.includes("alert")
  ){

    return "alert";

  }


  if(
    q.includes("power") ||
    q.includes("strong") ||
    q.includes("strongest") ||
    q.includes("gojo") ||
    q.includes("domain")
  ){

    return "power";

  }


  if(
    q.includes("math") ||
    q.includes("calculate") ||
    q.includes("physics") ||
    q.includes("chemistry") ||
    q.includes("biology") ||
    q.includes("science") ||
    q.includes("explain") ||
    q.includes("how") ||
    q.includes("why") ||
    q.includes("what")
  ){

    return "thinking";

  }


  if(
    q==="bye" ||
    q==="goodbye"
  ){

    return "bye";

  }


  return "thinking";

}


