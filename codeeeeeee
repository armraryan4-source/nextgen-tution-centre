function openLogin(){

  document
    .getElementById('loginOverlay')
    .classList.add('active');

  document
    .getElementById('loginUsername')
    .focus();
}


function closeLogin(){

  document
    .getElementById('loginOverlay')
    .classList.remove('active');

}


function login(){

  const username =
    document
      .getElementById('loginUsername')
      .value
      .trim();

  const password =
    document
      .getElementById('loginPassword')
      .value;

  const message =
    document
      .getElementById('loginMessage');

  const button =
    document
      .getElementById('loginButton');


  if(
    !username ||
    !password
  ){

    message.textContent =
      'Username aur password enter karo.';

    return;
  }


  button.disabled = true;
  button.textContent =
    'Logging in...';

  message.textContent =
    '';


  google.script.run
    .withSuccessHandler(
      function(result){

        button.disabled = false;
        button.textContent =
          '🔐 Login';

        if(
          result &&
          result.success
        ){

          sessionToken =
            result.token;

          currentUserType =
            result.type;

          closeLogin();

          document
            .getElementById('loginPassword')
            .value = '';

          if(
            result.type ===
            'ADMIN'
          ){

            openAdminDashboard();

          }else{

            openStudentDashboard();

          }

        }else{

          message.textContent =
            result.message ||
            'Login failed.';

        }

      }
    )
    .withFailureHandler(
      function(error){

        button.disabled = false;
        button.textContent =
          '🔐 Login';

        message.textContent =
          error.message ||
          'Server error.';

      }
    )
    .loginUser(
      username,
      password
    );

}


