<!DOCTYPE html>
<html>

<head>

  <base target="_top">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>NextGen Tuition Centre</title>

  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial,Helvetica,sans-serif;
      background:#05070d;
      color:white;
      overflow-x:hidden;
    }

    button,
    input,
    select,
    textarea{
      font-family:inherit;
    }

    button{
      cursor:pointer;
    }


    /* =====================================================
       BACKGROUND VIDEO
    ===================================================== */

    #bgVideo{
      position:fixed;
      top:50%;
      left:50%;
      width:100vw;
      height:100vh;
      object-fit:cover;
      transform:translate(-50%,-50%);
      z-index:-5;
      pointer-events:none;
      background:#05070d;
    }

    .video-overlay{
      position:fixed;
      inset:0;
      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,.72),
          rgba(0,0,0,.48),
          rgba(0,0,0,.82)
        );
      z-index:-4;
      pointer-events:none;
    }

    .ambient-glow{
      position:fixed;
      width:500px;
      height:500px;
      border-radius:50%;
      background:
        radial-gradient(
          circle,
          rgba(0,153,255,.18),
          transparent 70%
        );
      top:10%;
      left:-150px;
      filter:blur(30px);
      z-index:-3;
      pointer-events:none;
    }

    .ambient-glow2{
      position:fixed;
      width:450px;
      height:450px;
      border-radius:50%;
      background:
        radial-gradient(
          circle,
          rgba(120,0,255,.16),
          transparent 70%
        );
      bottom:0;
      right:-120px;
      filter:blur(30px);
      z-index:-3;
      pointer-events:none;
    }


    /* =====================================================
       NAVBAR
    ===================================================== */

    .navbar{
      position:fixed;
      top:0;
      left:0;
      width:100%;
      z-index:1000;
      padding:15px 6%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:rgba(5,8,18,.72);
      backdrop-filter:blur(15px);
      border-bottom:1px solid rgba(255,255,255,.10);
    }

    .logo{
      font-size:22px;
      font-weight:900;
      letter-spacing:1px;
      color:white;
      text-decoration:none;
    }

    .logo span{
      color:#38a8ff;
    }

    .nav-links{
      display:flex;
      gap:8px;
      list-style:none;
      align-items:center;
    }

    .nav-links a{
      color:white;
      text-decoration:none;
      font-size:14px;
      padding:9px 12px;
      border-radius:10px;
      transition:.25s;
    }

    .nav-links a:hover{
      background:rgba(0,150,255,.18);
      color:#55b8ff;
    }

    .login-nav-btn{
      background:#168de2 !important;
      box-shadow:0 5px 20px rgba(0,140,255,.25);
    }

    .menu-btn{
      display:none;
      border:none;
      background:rgba(255,255,255,.10);
      color:white;
      padding:9px 12px;
      border-radius:10px;
      font-size:20px;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .hero{
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      text-align:center;
      padding:120px 20px 70px;
    }

    .hero-content{
      max-width:950px;
      animation:heroIn 1s ease;
    }

    @keyframes heroIn{
      from{
        opacity:0;
        transform:translateY(30px);
      }

      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    .badge{
      display:inline-block;
      padding:8px 15px;
      border-radius:30px;
      background:rgba(0,145,255,.16);
      border:1px solid rgba(70,180,255,.35);
      color:#8bd2ff;
      font-size:13px;
      margin-bottom:20px;
    }

    .hero h1{
      font-size:clamp(42px,8vw,88px);
      line-height:.98;
      font-weight:900;
      letter-spacing:-3px;
      text-shadow:0 0 30px rgba(0,150,255,.25);
    }

    .hero h1 span{
      color:#35a9ff;
      text-shadow:0 0 30px rgba(0,150,255,.45);
    }

    .hero h2{
      margin-top:20px;
      font-size:clamp(20px,3vw,32px);
      font-weight:600;
      color:#e5edf5;
    }

    .hero p{
      margin:18px auto 0;
      max-width:700px;
      color:#c7d0da;
      line-height:1.7;
      font-size:16px;
    }

    .hero-buttons{
      display:flex;
      justify-content:center;
      flex-wrap:wrap;
      gap:12px;
      margin-top:30px;
    }


    /* =====================================================
       BUTTONS
    ===================================================== */

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:145px;
      padding:13px 20px;
      border-radius:13px;
      text-decoration:none;
      font-weight:700;
      transition:.25s;
      cursor:pointer;
      border:1px solid rgba(255,255,255,.15);
    }

    .btn-primary{
      background:#168de2;
      color:white;
      box-shadow:0 8px 30px rgba(0,140,255,.25);
    }

    .btn-primary:hover{
      transform:translateY(-3px);
      background:#27a0f5;
    }

    .btn-secondary{
      background:rgba(255,255,255,.08);
      color:white;
      backdrop-filter:blur(10px);
    }

    .btn-secondary:hover{
      transform:translateY(-3px);
      background:rgba(255,255,255,.14);
    }


    /* =====================================================
       SECTIONS
    ===================================================== */

    section{
      padding:90px 6%;
      position:relative;
    }

    .section-title{
      text-align:center;
      max-width:750px;
      margin:0 auto 45px;
    }

    .section-title .small{
      color:#48b2ff;
      font-size:13px;
      font-weight:800;
      letter-spacing:2px;
      text-transform:uppercase;
    }

    .section-title h2{
      font-size:clamp(30px,5vw,50px);
      margin-top:8px;
      font-weight:900;
    }

    .section-title p{
      margin-top:12px;
      color:#b9c5d0;
      line-height:1.7;
    }


    /* =====================================================
       CARDS
    ===================================================== */

    .grid{
      max-width:1200px;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:20px;
    }

    .card{
      padding:27px;
      border-radius:22px;
      background:rgba(8,13,24,.67);
      border:1px solid rgba(255,255,255,.10);
      backdrop-filter:blur(15px);
      box-shadow:0 20px 60px rgba(0,0,0,.20);
      transition:.3s;
    }

    .card:hover{
      transform:translateY(-7px);
      border-color:rgba(50,170,255,.35);
      box-shadow:0 20px 60px rgba(0,100,200,.14);
    }

    .card-icon{
      width:55px;
      height:55px;
      display:flex;
      align-items:center;
      justify-content:center;
      border-radius:15px;
      background:rgba(0,145,255,.15);
      font-size:25px;
      margin-bottom:18px;
    }

    .card h3{
      font-size:21px;
      margin-bottom:10px;
    }

    .card p{
      color:#b9c5d0;
      line-height:1.65;
      font-size:14px;
    }


    /* =====================================================
       CLASSES
    ===================================================== */

    .class-card{
      text-align:center;
    }

    .class-number{
      font-size:40px;
      font-weight:900;
      color:#40adff;
      margin-bottom:10px;
    }

    .class-card h3{
      margin-bottom:8px;
    }

    .subject-list{
      color:#c4ced8;
      font-size:14px;
      line-height:1.8;
    }


    /* =====================================================
       TESTS
    ===================================================== */

    .test-box{
      max-width:1000px;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:20px;
    }

    .test-card{
      padding:30px;
      border-radius:22px;
      background:rgba(8,13,24,.70);
      border:1px solid rgba(255,255,255,.10);
      backdrop-filter:blur(15px);
    }

    .test-card h3{
      font-size:24px;
      margin-bottom:10px;
    }

    .test-card p{
      color:#bdc7d1;
      line-height:1.7;
      margin-bottom:20px;
    }


    /* =====================================================
       RESULTS
    ===================================================== */

    .result-table-wrap{
      max-width:1000px;
      margin:auto;
      overflow-x:auto;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.10);
      background:rgba(5,9,18,.65);
      backdrop-filter:blur(15px);
    }

    table{
      width:100%;
      border-collapse:collapse;
      min-width:650px;
    }

    th,
    td{
      padding:16px;
      text-align:left;
      border-bottom:1px solid rgba(255,255,255,.08);
    }

    th{
      color:#65bcff;
      background:rgba(0,130,220,.10);
    }

    td{
      color:#d7dfe7;
    }


    /* =====================================================
       ACHIEVEMENTS
    ===================================================== */

    .achievement{
      text-align:center;
    }

    .achievement-number{
      font-size:42px;
      font-weight:900;
      color:#46afff;
    }

    .achievement p{
      margin-top:5px;
      color:#bbc5cf;
    }


    /* =====================================================
       CONTACT
    ===================================================== */

    .contact-grid{
      max-width:1050px;
      margin:auto;
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:20px;
    }

    .contact-card{
      padding:30px;
      border-radius:22px;
      background:rgba(8,13,24,.70);
      border:1px solid rgba(255,255,255,.10);
      backdrop-filter:blur(15px);
    }

    .contact-card h3{
      margin-bottom:15px;
      font-size:23px;
    }

    .contact-card p{
      color:#bcc6d0;
      line-height:1.8;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    footer{
      padding:35px 20px;
      text-align:center;
      border-top:1px solid rgba(255,255,255,.08);
      background:rgba(3,5,10,.75);
      backdrop-filter:blur(15px);
    }

    footer p{
      color:#9faab5;
      font-size:13px;
      line-height:1.6;
    }


    /* =====================================================
       LOGIN OVERLAY
    ===================================================== */

    .overlay{
      position:fixed;
      inset:0;
      z-index:5000;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:rgba(0,0,0,.78);
      backdrop-filter:blur(15px);
    }

    .overlay.active{
      display:flex;
    }

    .login-box{
      width:min(450px,100%);
      padding:32px;
      border-radius:25px;
      background:
        linear-gradient(
          145deg,
          rgba(10,20,38,.96),
          rgba(6,10,20,.96)
        );
      border:1px solid rgba(60,175,255,.30);
      box-shadow:
        0 30px 100px rgba(0,0,0,.60),
        0 0 50px rgba(0,130,255,.12);
      position:relative;
    }

    .close-btn{
      position:absolute;
      top:15px;
      right:15px;
      width:35px;
      height:35px;
      border-radius:50%;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.07);
      color:white;
      font-size:20px;
    }

    .login-logo{
      text-align:center;
      font-size:35px;
      font-weight:900;
      margin-bottom:5px;
    }

    .login-logo span{
      color:#38a8ff;
    }

    .login-subtitle{
      text-align:center;
      color:#9eafbf;
      margin-bottom:25px;
    }

    .input-group{
      margin-bottom:15px;
    }

    .input-group label{
      display:block;
      color:#b8c8d7;
      font-size:13px;
      margin-bottom:7px;
    }

    .input-group input,
    .input-group select,
    .input-group textarea{
      width:100%;
      padding:13px 14px;
      border-radius:12px;
      border:1px solid rgba(255,255,255,.12);
      outline:none;
      background:rgba(255,255,255,.06);
      color:white;
    }

    .input-group select option{
      background:#101827;
      color:white;
    }

    .input-group textarea{
      min-height:80px;
      resize:vertical;
    }

    .login-submit{
      width:100%;
      margin-top:8px;
    }

    .login-message{
      min-height:22px;
      text-align:center;
      color:#ff9c9c;
      font-size:13px;
      margin-top:12px;
    }


    /* =====================================================
       DASHBOARD
    ===================================================== */

    .dashboard{
      position:fixed;
      inset:0;
      z-index:4500;
      display:none;
      background:
        radial-gradient(
          circle at 20% 10%,
          rgba(0,130,255,.12),
          transparent 30%
        ),
        #050912;
      overflow-y:auto;
    }

    .dashboard.active{
      display:block;
    }

    .dashboard-nav{
      position:sticky;
      top:0;
      z-index:20;
      padding:15px 5%;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:15px;
      background:rgba(5,9,18,.90);
      border-bottom:1px solid rgba(255,255,255,.10);
      backdrop-filter:blur(18px);
    }

    .dashboard-brand{
      font-size:20px;
      font-weight:900;
    }

    .dashboard-brand span{
      color:#39aaff;
    }

    .dashboard-user{
      color:#b7c8d8;
      font-size:13px;
    }

    .logout-btn{
      padding:9px 15px;
      border-radius:10px;
      border:1px solid rgba(255,100,100,.25);
      background:rgba(255,60,60,.10);
      color:#ffb4b4;
    }

    .dashboard-container{
      max-width:1250px;
      margin:auto;
      padding:30px 5% 70px;
    }

    .welcome-card{
      padding:30px;
      border-radius:25px;
      background:
        linear-gradient(
          135deg,
          rgba(0,135,255,.16),
          rgba(80,0,255,.10)
        );
      border:1px solid rgba(70,180,255,.20);
      margin-bottom:25px;
    }

    .welcome-card h1{
      font-size:clamp(28px,5vw,45px);
      margin-bottom:8px;
    }

    .welcome-card p{
      color:#b9c8d5;
    }

    .stats{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:15px;
      margin-bottom:25px;
    }

    .stat{
      padding:22px;
      border-radius:20px;
      background:rgba(255,255,255,.045);
      border:1px solid rgba(255,255,255,.08);
    }

    .stat-icon{
      font-size:25px;
      margin-bottom:12px;
    }

    .stat-number{
      font-size:30px;
      font-weight:900;
    }

    .stat-label{
      color:#8fa2b3;
      font-size:13px;
      margin-top:4px;
    }

    .dashboard-section{
      margin-top:25px;
    }

    .dashboard-section h2{
      margin-bottom:15px;
      font-size:25px;
    }

    .dashboard-table{
      width:100%;
      min-width:650px;
      border-collapse:collapse;
    }

    .dashboard-table-wrap{
      overflow:auto;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.08);
      background:rgba(255,255,255,.035);
    }

    .empty{
      padding:35px;
      text-align:center;
      color:#8293a3;
    }

    .pill{
      display:inline-block;
      padding:5px 9px;
      border-radius:20px;
      font-size:11px;
      font-weight:700;
    }

    .present{
      background:rgba(0,210,130,.12);
      color:#68e8b0;
    }

    .absent{
      background:rgba(255,70,70,.12);
      color:#ff9b9b;
    }

    .material-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:15px;
    }

    .material-box{
      padding:20px;
      border-radius:18px;
      background:rgba(255,255,255,.045);
      border:1px solid rgba(255,255,255,.08);
    }

    .material-box h3{
      margin-bottom:8px;
    }

    .material-box p{
      color:#9fb0bf;
      font-size:13px;
      line-height:1.5;
      margin-bottom:15px;
    }


    /* =====================================================
       ADMIN
    ===================================================== */

    .admin-dashboard{
      position:fixed;
      inset:0;
      z-index:4600;
      display:none;
      background:#050912;
      overflow-y:auto;
    }

    .admin-dashboard.active{
      display:block;
    }

    .admin-nav{
      position:sticky;
      top:0;
      z-index:30;
      padding:14px 4%;
      display:flex;
      align-items:center;
      justify-content:space-between;
      background:rgba(4,8,16,.94);
      border-bottom:1px solid rgba(255,255,255,.09);
      backdrop-filter:blur(18px);
    }

    .admin-title{
      font-weight:900;
      font-size:20px;
    }

    .admin-title span{
      color:#38a8ff;
    }

    .admin-container{
      max-width:1400px;
      margin:auto;
      padding:25px 4% 70px;
    }

    .admin-stats{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:15px;
      margin-bottom:25px;
    }

    .admin-card{
      background:rgba(255,255,255,.045);
      border:1px solid rgba(255,255,255,.08);
      border-radius:20px;
      padding:22px;
    }

    .admin-card h2{
      font-size:18px;
      margin-bottom:15px;
    }

    .admin-form-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:12px;
    }

    .admin-form-grid .full{
      grid-column:1/-1;
    }

    .admin-actions{
      display:flex;
      gap:8px;
      flex-wrap:wrap;
    }

    .small-btn{
      padding:8px 11px;
      border-radius:9px;
      border:1px solid rgba(255,255,255,.12);
      background:rgba(255,255,255,.06);
      color:white;
      font-size:12px;
    }

    .small-btn:hover{
      background:rgba(0,150,255,.15);
    }

    .danger-btn{
      color:#ff9f9f;
      border-color:rgba(255,80,80,.20);
    }

    .admin-section{
      margin-top:22px;
    }

    .admin-section h2{
      margin-bottom:14px;
    }

    .admin-table-wrap{
      overflow:auto;
      border-radius:18px;
      border:1px solid rgba(255,255,255,.08);
    }

    .admin-table{
      width:100%;
      min-width:900px;
      border-collapse:collapse;
      background:rgba(255,255,255,.025);
    }

    .admin-table th,
    .admin-table td{
      padding:12px;
      border-bottom:1px solid rgba(255,255,255,.07);
      font-size:13px;
      white-space:nowrap;
    }

    .admin-table th{
      color:#61baff;
      background:rgba(0,130,220,.09);
    }

    .admin-message{
      min-height:22px;
      color:#6edaff;
      margin-top:10px;
      font-size:13px;
    }

    .password-popup{
      position:fixed;
      inset:0;
      z-index:7000;
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      background:rgba(0,0,0,.80);
      backdrop-filter:blur(12px);
    }

    .password-popup.active{
      display:flex;
    }

    .password-card{
      width:min(430px,100%);
      padding:30px;
      border-radius:22px;
      background:#0b1321;
      border:1px solid rgba(70,180,255,.30);
      text-align:center;
    }

    .generated-password{
      margin:20px 0;
      padding:18px;
      border-radius:15px;
      background:rgba(0,150,255,.10);
      border:1px solid rgba(0,150,255,.20);
      font-size:23px;
      font-weight:900;
      letter-spacing:1px;
      color:#71c7ff;
      word-break:break-all;
    }


    /* =====================================================
       TOP BUTTON
    ===================================================== */

    #topBtn{
      position:fixed;
      right:20px;
      bottom:20px;
      width:45px;
      height:45px;
      border-radius:50%;
      border:1px solid rgba(255,255,255,.15);
      background:rgba(8,15,27,.80);
      color:white;
      cursor:pointer;
      display:none;
      z-index:999;
      backdrop-filter:blur(10px);
      font-size:18px;
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media(max-width:900px){

      .nav-links{
        position:absolute;
        top:68px;
        left:4%;
        right:4%;
        display:none;
        flex-direction:column;
        align-items:stretch;
        padding:12px;
        border-radius:18px;
        background:rgba(5,8,17,.95);
        border:1px solid rgba(255,255,255,.10);
        backdrop-filter:blur(20px);
      }

      .nav-links.active{
        display:flex;
      }

      .nav-links a{
        text-align:center;
      }

      .menu-btn{
        display:block;
      }

      .grid{
        grid-template-columns:repeat(2,1fr);
      }

      .stats,
      .admin-stats{
        grid-template-columns:repeat(2,1fr);
      }

      .material-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .admin-form-grid{
        grid-template-columns:repeat(2,1fr);
      }
    }


    @media(max-width:600px){

      section{
        padding:70px 5%;
      }

      .hero{
        padding-top:110px;
      }

      .hero h1{
        letter-spacing:-2px;
      }

      .grid,
      .test-box,
      .contact-grid{
        grid-template-columns:1fr;
      }

      .hero-buttons{
        flex-direction:column;
      }

