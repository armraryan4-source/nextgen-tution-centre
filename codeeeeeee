function addStudent(){

  const name =
    document
      .getElementById(
        'newStudentName'
      )
      .value
      .trim();

  const studentClass =
    document
      .getElementById(
        'newStudentClass'
      )
      .value;


  if(!name){

    document
      .getElementById(
        'studentMessage'
      )
      .textContent =
      'Student name required.';

    return;
  }


  google.script.run
    .withSuccessHandler(
      function(result){

        document
          .getElementById(
            'studentMessage'
          )
          .textContent =
          'Student added successfully.';

        document
          .getElementById(
            'newStudentName'
          )
          .value = '';

        document
          .getElementById(
            'newStudentClass'
          )
          .value = '';

        showPassword(
          result.student.password
        );

        loadAdminDashboard();

      }
    )
    .withFailureHandler(
      showError
    )
    .addStudent(
      sessionToken,
      name,
      studentClass
    );

}


/* =========================================================
   EDIT STUDENT
========================================================= */

function editStudent(studentId){

  const student =
    adminData.students.find(
      function(s){
        return s.id === studentId;
      }
    );

  if(!student){
    return;
  }


  const name =
    prompt(
      'Student name:',
      student.name
    );

  if(
    name === null
  ){
    return;
  }


  const studentClass =
    prompt(
      'Class:',
      student.className
    );

  if(
    studentClass === null
  ){
    return;
  }


  const status =
    confirm(
      'OK = Active\nCancel = Inactive'
    )
      ? 'Active'
      : 'Inactive';


  google.script.run
    .withSuccessHandler(
      function(){

        loadAdminDashboard();

      }
    )
    .withFailureHandler(
      showError
    )
    .updateStudent(
      sessionToken,
      studentId,
      name,
      studentClass,
      status
    );

}


