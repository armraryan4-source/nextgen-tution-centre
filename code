/* ================================================= */

function closeNotes(){

  notesPanel.classList.remove(
    "show"
  );

}


/* ================================================= */
/* CREATE NEW NOTE */
/* ================================================= */

function openNewNote(){

  const now =
    new Date().toISOString();


  const newNote={

    id:
      Date.now().toString(),

    title:
      "New Note",

    content:
      "",

    pinned:
      false,

    createdAt:
      now,

    updatedAt:
      now

  };


  notes.unshift(
    newNote
  );


  currentNoteId =
    newNote.id;


  saveNotes();

  renderNotes();

  loadNoteIntoEditor(
    newNote
  );


  setTimeout(
    function(){

      noteTitle.focus();

      noteTitle.select();

    },
    100
  );

}


/* ================================================= */
/* SELECT NOTE */
/* ================================================= */

function selectNote(id){

  const note =
    notes.find(
      function(n){

        return n.id===id;

      }
    );


  if(!note){

    return;

  }


  currentNoteId=id;

  loadNoteIntoEditor(
    note
  );

  renderNotes();

}


/* ================================================= */
/* LOAD NOTE INTO EDITOR */
/* ================================================= */

function loadNoteIntoEditor(note){

  noteTitle.value =
    note.title || "";

  noteContent.value =
    note.content || "";


  updatePinButton(
    note.pinned
  );


  noteUpdated.innerText =
    "Updated " +
    formatNoteDate(
      note.updatedAt
    );

}


/* ================================================= */
/* RENDER NOTES */
/* ================================================= */

function renderNotes(){

  if(!notesList){

    return;

  }


  const search =
    noteSearch.value
      .toLowerCase()
      .trim();


  let filtered =
    notes.filter(
      function(note){

        return (
          !search ||
          String(note.title || "")
            .toLowerCase()
            .includes(search) ||
          String(note.content || "")
            .toLowerCase()
            .includes(search)
        );

      }
    );


  if(filtered.length===0){

    notesList.innerHTML =
      `
      <div class="notesEmpty">
        📝<br><br>
        ${
          search
            ? "No matching notes found."
            : "No notes yet.<br>Create your first note."
        }
      </div>
      `;

    return;

  }


  notesList.innerHTML="";


  filtered.forEach(
    function(note){

      const item =
        document.createElement(
          "div"
        );

      item.className =
        "noteItem";


      if(
        note.id ===
        currentNoteId
      ){

        item.classList.add(
          "active"
        );

      }


      const title =
        document.createElement(
          "div"
        );

      title.className =
        "noteItemTitle";


      title.innerText =
        (
          note.pinned
            ? "📌 "
            : ""
        ) +
        (
          note.title ||
          "Untitled Note"
        );


      const preview =
        document.createElement(
          "div"
        );

      preview.className =
        "noteItemPreview";


      preview.innerText =
        note.content
          ? note.content
              .replace(/\s+/g," ")
              .slice(0,80)
          : "Empty note";


      const date =
        document.createElement(
          "div"
        );

      date.className =
        "noteItemDate";


      date.innerText =
        formatNoteDate(
          note.updatedAt
        );


      item.appendChild(
        title
      );

      item.appendChild(
        preview
      );

      item.appendChild(
        date
      );


      item.onclick =
        function(){

          selectNote(
            note.id
          );

        };


      notesList.appendChild(
        item
      );

    }
  );

}


/* ================================================= */
/* SAVE CURRENT NOTE */
/* ================================================= */

function saveCurrentNote(){

  if(
    currentNoteId===null
  ){

    openNewNote();

    return;

  }


  const note =
    notes.find(
      function(n){

        return n.id===
          currentNoteId;

      }
    );


  if(!note){

    return;

  }


  note.title =
    noteTitle.value.trim() ||
    "Untitled Note";


  note.content =
    noteContent.value;


  note.updatedAt =
    new Date().toISOString();


  saveNotes();

  sortNotes();

  renderNotes();


  noteUpdated.innerText =
    "Saved just now";


  setTimeout(
    function(){

      if(currentNoteId===note.id){

        noteUpdated.innerText =
          "Updated " +
          formatNoteDate(
            note.updatedAt
          );

      }

    },
    1500
  );

}


/* ================================================= */
/* AUTO SAVE */
/* ================================================= */

function autoSaveNote(){

  clearTimeout(
    noteAutoSaveTimer
  );


  noteAutoSaveTimer =
    setTimeout(
      function(){

        if(
          currentNoteId !== null
        ){

          saveCurrentNote();

        }

      },
      500
    );

}


/* ================================================= */
/* TITLE CHANGE */
/* ================================================= */

noteTitle.addEventListener(
  "input",
  function(){

    autoSaveNote();

  }
);


/* ================================================= */
/* CONTENT CHANGE */
/* ================================================= */

noteContent.addEventListener(
  "input",
  function(){

    autoSaveNote();

  }
);


/* ================================================= */
/* SEARCH */
/* ================================================= */

noteSearch.addEventListener(
  "input",
  function(){

    renderNotes();

  }
);


/* ================================================= */
/* PIN NOTE */
/* ================================================= */

function togglePinNote(){

  if(
    currentNoteId===null
  ){

    return;

  }


  const note =
    notes.find(
      function(n){

        return n.id===
          currentNoteId;

      }
    );


  if(!note){

    return;

  }


  note.pinned =
    !note.pinned;


  note.updatedAt =
    new Date().toISOString();


  updatePinButton(
    note.pinned
  );


  saveNotes();

  sortNotes();

  renderNotes();

}


/* ================================================= */
/* PIN BUTTON UI */
/* ================================================= */

function updatePinButton(pinned){

  if(pinned){

    pinNoteBtn.innerText =
      "📌 Pinned";

    pinNoteBtn.classList.add(
      "pinned"
    );

  }

  else{

    pinNoteBtn.innerText =
      "📌 Pin";

    pinNoteBtn.classList.remove(
      "pinned"
    );

  }

}


/* ================================================= */
/* DELETE NOTE */
/* ================================================= */

function deleteCurrentNote(){

  if(
    currentNoteId===null
  ){

    return;

  }


  const note =
    notes.find(
      function(n){

        return n.id===
          currentNoteId;

      }
    );


  if(!note){

    return;

  }


  const confirmed =
    confirm(
      "Delete this note?"
    );


  if(!confirmed){

    return;

  }


  notes =
    notes.filter(
      function(n){

        return n.id !==
          currentNoteId;

      }
    );


  currentNoteId=null;

  saveNotes();

  renderNotes();


  if(notes.length>0){

    sortNotes();

    selectNote(
      notes[0].id
    );

  }

  else{

    noteTitle.value="";

    noteContent.value="";

    noteUpdated.innerText =
      "No note selected";

    updatePinButton(
      false
    );

  }

}


/* ================================================= */
/* DATE FORMAT */
/* ================================================= */

function formatNoteDate(dateString){

  if(!dateString){

    return "";

  }


  const date =
    new Date(
      dateString
    );


  if(
    isNaN(
      date.getTime()
    )
  ){

    return "";

  }


  const now =
    new Date();


  const diff =
    now.getTime() -
    date.getTime();


  const minutes =
    Math.floor(
      diff / 60000
    );


  if(minutes < 1){

    return "just now";

  }


  if(minutes < 60){

    return (
      minutes +
      " min ago"
    );

  }


  const hours =
    Math.floor(
      minutes / 60
    );


  if(hours < 24){

    return (
      hours +
      " hr ago"
    );

  }


  const days =
    Math.floor(
      hours / 24
    );


  if(days < 7){

    return (
      days +
      " day" +
      (
        days===1
          ? ""
          : "s"
      ) +
      " ago"
    );

  }


  return date.toLocaleDateString(
    "en-IN",
    {
      day:"2-digit",
      month:"short",
      year:"numeric"
    }
  );

}


/* ================================================= */
/* NOTES KEYBOARD SHORTCUTS */
/* ================================================= */

document.addEventListener(
  "keydown",
  function(event){

    if(
      event.key==="Escape" &&
      notesPanel.classList.contains(
        "show"
      )
    ){

      closeNotes();

    }


    if(
      (event.ctrlKey ||
       event.metaKey) &&
      event.key.toLowerCase()==="s" &&
      notesPanel.classList.contains(
        "show"
      )
    ){

      event.preventDefault();

      saveCurrentNote();

    }

  }
);


/* ================================================= */
/* START NOTES */
/* ================================================= */

loadNotes();

</script>

